{
  "name": "moontv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-manifest.js && node scripts/generate-runtime.js && next dev -H 0.0.0.0",
    "build": "node scripts/generate-manifest.js && node scripts/generate-runtime.js && next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "node scripts/generate-runtime.js && tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest --passWithNoTests",
    "audit:sources": "node scripts/audit-sources.mjs",
    "verify": "corepack pnpm audit && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm test:sql && corepack pnpm test:transport && corepack pnpm build && corepack pnpm test:built-transport",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:runtime": "node scripts/generate-runtime.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install",
    "gen:version": "node scripts/convert-changelog.js",
    "check:version": "node scripts/convert-changelog.js --check",
    "test:sql": "node migrations/supabase/tests/atomic-kv.mjs && node migrations/supabase/tests/namespace-mutations.mjs && node migrations/supabase/tests/rate-limits.test.mjs && node migrations/supabase/tests/service-table-privileges.mjs",
    "test:transport": "node --test scripts/pinned-fetch.test.cjs",
    "test:built-transport": "node scripts/pinned-proxy-build-smoke.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/crypto-js": "^4.2.2",
    "@vidstack/react": "^1.12.13",
    "artplayer": "^5.2.5",
    "artplayer-plugin-danmuku": "^5.2.0",
    "cheerio": "1.0.0",
    "chinese-conv": "^1.1.0",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.18.1",
    "glob-to-regexp": "^0.4.1",
    "he": "^1.2.0",
    "hls.js": "^1.6.6",
    "lucide-react": "^0.438.0",
    "media-icons": "^1.1.5",
    "mux.js": "github:Momo707577045/mux.js",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.4.0",
    "sweetalert2": "^11.11.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^2.6.0",
    "undici": "^8.12.2",
    "vidstack": "^0.6.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@electric-sql/pglite": "0.5.11",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/aria-query": "^5.0.4",
    "@types/he": "^1.2.3",
    "@types/jest": "^27.5.2",
    "@types/node": "24.0.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "supabase": "^2.98.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.5.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --plugin-search-dir .husky -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier --plugin-search-dir .husky -w"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@babel/core@>=7.0.0 <7.29.7": "7.29.7",
      "@babel/plugin-transform-modules-systemjs@<=7.29.3": "7.29.4",
      "@tootallnate/once@<3.0.1": "3.0.1",
      "ajv@<6.14.0": "6.15.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.27": "2.11.27",
      "brace-expansion@<1.1.21": "1.1.21",
      "browserslist@>=4.0.0 <4.29.3": "4.29.3",
      "diff@>=4.0.0 <4.0.4": "4.0.4",
      "flatted@<=3.4.1": "3.4.2",
      "form-data@>=3.0.0 <3.0.5": "3.0.5",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash": "4.18.1",
      "minimatch@<3.1.5": "3.1.5",
      "nanoid@>=3.0.0 <3.3.20": "3.3.20",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.23",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "svgo@>=3.0.0 <3.3.5": "3.3.5",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "ws@>=7.0.0 <7.5.13": "7.5.13",
      "yaml@<1.10.3": "1.10.3",
      "sharp@>=0.34.0 <0.35.5": "0.35.5",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "undici@>=6.0.0 <6.29.1": "6.29.1"
    }
  },
  "engines": {
    "node": ">=22.19.0 <23"
  }
}
