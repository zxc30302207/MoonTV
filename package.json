{
  "name": "moontv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-manifest.js && node scripts/generate-runtime.js && next dev -H 0.0.0.0",
    "build": "node scripts/generate-manifest.js && node scripts/generate-runtime.js && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "node scripts/generate-runtime.js && tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest --passWithNoTests",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:runtime": "node scripts/generate-runtime.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@types/crypto-js": "^4.2.2",
    "@upstash/redis": "^1.25.0",
    "@vidstack/react": "^1.12.13",
    "artplayer": "^5.2.5",
    "artplayer-plugin-danmuku": "^5.2.0",
    "chinese-conv": "^1.1.0",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.18.1",
    "glob-to-regexp": "^0.4.1",
    "he": "^1.2.0",
    "hls.js": "^1.6.6",
    "lucide-react": "^0.438.0",
    "media-icons": "^1.1.5",
    "mux.js": "github:Momo707577045/mux.js",
    "next": "15.5.15",
    "next-themes": "^0.4.6",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.4.0",
    "redis": "^4.6.7",
    "sweetalert2": "^11.11.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^2.6.0",
    "vidstack": "^0.6.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/aria-query": "^5.0.4",
    "@types/he": "^1.2.3",
    "@types/node": "24.0.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.14",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs@<=7.29.3": "7.29.4",
      "@tootallnate/once@<3.0.1": "3.0.1",
      "ajv@<6.14.0": "6.15.0",
      "brace-expansion@<1.1.14": "1.1.14",
      "diff@>=4.0.0 <4.0.4": "4.0.4",
      "flatted@<=3.4.1": "3.4.2",
      "lodash": "4.18.1",
      "minimatch@<3.1.5": "3.1.5",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.14",
      "svgo@>=3.0.0 <3.3.3": "3.3.3",
      "yaml@<1.10.3": "1.10.3"
    }
  }
}
